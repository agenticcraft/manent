{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manent",
  "version": "0.1.0",
  "identifier": "ai.agenticcraft.manent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Manent",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AgenticCraft",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "homepage": "https://agenticcraft.ai/manent",
    "category": "Productivity",
    "shortDescription": "Local meeting recorder and transcriber",
    "longDescription": "Manent records meetings (your microphone and the system audio) and transcribes them live on this computer, in Dutch and English, with speakers. Nothing leaves the computer unless you sync with your own Nextcloud.",
    "copyright": "© 2026 AgenticCraft",
    "linux": {
      "rpm": {
        "files": {
          "/usr/bin/manent-engine": "target/release/manent-engine",
          "/usr/share/licenses/manent/LICENSE": "../LICENSE",
          "/usr/share/applications/ai.agenticcraft.manent.desktop": "linux/ai.agenticcraft.manent.desktop"
        },
        "release": "1",
        "desktopTemplate": "linux/hidden.desktop.hbs"
      }
    }
  }
}
